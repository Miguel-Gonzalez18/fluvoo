# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth — Gmail (required for step 3 onboarding)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback

# FX fallback for USD-only bank emails (open.er-api.com). Set false to skip usd-only emails.
FX_API_ENABLED=true

# Gemini — fiscal analysis IA (AI SDK reads GEMINI_API_KEY or GOOGLE_GENERATIVE_AI_API_KEY)
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FISCAL_ANALYSIS_CACHE_HOURS=24

# Background Gmail sync + notifications (Vercel Cron — Hobby: once daily, see vercel.json)
CRON_SECRET=

# Resend — expense email notifications
RESEND_API_KEY=
RESEND_FROM_EMAIL=notificaciones@tudominio.com

# App URL for notification deep links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Web Push (VAPID) — run: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hola@fluvoo.com